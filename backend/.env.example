# Server-side only. Never commit real credentials.
PORT=8787
NEXORA_CORS_ORIGIN=https://clevotech.github.io
NEXORA_DEV_AUTH=false

# Authentication
NEXORA_AUTH_ISSUER=
NEXORA_AUTH_AUDIENCE=

# Database
DATABASE_URL=
NEXORA_DB_POOL_MAX=10

# AI providers
NEXORA_OPENAI_API_KEY=
NEXORA_OPENAI_BASE_URL=https://api.openai.com/v1
NEXORA_ANTHROPIC_API_KEY=
NEXORA_ANTHROPIC_BASE_URL=https://api.anthropic.com
NEXORA_GOOGLE_API_KEY=
NEXORA_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NEXORA_XAI_API_KEY=
NEXORA_XAI_BASE_URL=https://api.x.ai/v1
NEXORA_DEEPSEEK_API_KEY=
NEXORA_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
NEXORA_MISTRAL_API_KEY=
NEXORA_MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Private S3-compatible object storage
NEXORA_STORAGE_BUCKET=
NEXORA_STORAGE_REGION=us-east-1
NEXORA_STORAGE_ENDPOINT=
NEXORA_STORAGE_ACCESS_KEY=
NEXORA_STORAGE_SECRET_KEY=
NEXORA_STORAGE_PATH_STYLE=false

# Media model overrides
NEXORA_IMAGE_MODEL=gpt-image-2.5-flare
NEXORA_TRANSCRIBE_MODEL=gpt-transcribe
NEXORA_TTS_MODEL=gpt-4o-mini-tts
NEXORA_TTS_VOICE=marin
\n\n# Provider-neutral asynchronous video adapter (server-side only)\n# Contract: POST <URL> creates a job; GET <URL>/<jobId> returns status and a completed downloadUrl/url.\nNEXORA_VIDEO_API_URL=\nNEXORA_VIDEO_API_KEY=\nNEXORA_VIDEO_MODEL=\nNEXORA_VIDEO_POLL_MS=3000\nNEXORA_VIDEO_TIMEOUT_MS=1800000\n